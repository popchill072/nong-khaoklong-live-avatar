# ไปสมัคร key ฟรี: https://aistudio.google.com > API Key > Create API key
GEMINI_API_KEY=ใส่_GEMINI_API_KEY_ของคุณ
# (ไม่บังคับ) เปลี่ยนเสียง/โมเดลได้
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Aoede
PORT=3001

# LINE Official Account (ไม่บังคับ — ถ้าไม่ตั้ง โมดูล LINE จะปิด)
LINE_ENABLED=false
LINE_CHANNEL_ACCESS_TOKEN=ใส่_CHANNEL_ACCESS_TOKEN_ของคุณ
LINE_CHANNEL_SECRET=ใส่_CHANNEL_SECRET_ของคุณ
LINE_MODEL=gemini-3.5-flash