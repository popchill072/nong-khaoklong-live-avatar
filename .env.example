# ไปสมัคร key ฟรี: https://aistudio.google.com > API Key > Create API key
GEMINI_API_KEY=ใส่_GEMINI_API_KEY_ของคุณ
# (ไม่บังคับ) เปลี่ยนเสียง/โมเดลได้
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Aoede
PORT=3001

# LINE Official Account (ไม่บังคับ — ถ้าไม่ตั้ง โมดูล LINE จะปิด)
LINE_ENABLED=false
LINE_CHANNEL_ACCESS_TOKEN=ใส่_CHANNEL_ACCESS_TOKEN_ของคุณ
LINE_CHANNEL_SECRET=ใส่_CHANNEL_SECRET_ของคุณ
LINE_MODEL=gemini-3.5-flash
# การแจ้งเตือนเชิงรุกจาก LINE (push) — เตือนนัดล่วงหน้า ต้อง LINE_ENABLED=true ด้วย
LINE_REMINDERS_ENABLED=true
# ช่วงเวลาเตือนล่วงหน้า (นาทีก่อนถึงนัด, คั่นด้วยคอมม่า) เช่น 60,10,0 (0 = ตอนถึงเวลา)
# — ยิ่งน้อยรอบยิ่งประหยัด quota push (ไทย ~500 ข้อความ/เดือน)
LINE_REMINDER_OFFSETS=60,10,0
# (ไม่บังคับ) เปิดสรุปวันนี้แบบอัตโนมัติ — ส่ง "สรุปนัด + โน้ต" ให้ผู้ใช้ LINE ทุกคนที่เคยคุย
# ทุกวันตามเวลา HH:MM (เวลาไทย) เช่น 08:00 — 1 push/คน/วัน ต้อง LINE_ENABLED=true ด้วย
LINE_DAILY_BRIEF=08:00

# (ไม่บังคับ) ประกาศฟีเจอร์ใหม่/ข่าวสารไปยังผู้ใช้ LINE ทุกคนที่เคยคุย
# LINE_ADMIN_USER = LINE userId ของเจ้าของ (ดูได้จาก wrangler tail เมื่อเจ้าของพิมพ์ข้อความครั้งแรก)
#   → เจ้าของพิมพ์ "ประกาศ: <ข้อความ>" (หรือ "แจ้งข่าว: <ข้อความ>") ระบบจะบันทึกประกาศ
#     และ cron จะทยอย push ให้ผู้ใช้ทุกคน (ครั้งละ ~20 คน/รอบ, กันซ้ำต่อเวอร์ชัน)
#     ผู้ใช้ที่พิมพ์ "ปิดข่าว" จะไม่ถูกรบกวน / พิมพ์ "เปิดข่าว" กลับมารับได้
# LINE_ANNOUNCE_KEY = ใช้ประกาศทาง API ด้วย: POST /api/announce {text} + header x-announce-key: <ค่านี้>
LINE_ADMIN_USER=ใส่_LINE_USER_ID_ของเจ้าของ
LINE_ANNOUNCE_KEY=ใส่_รหัส_ประกาศ_ของคุณ